# Sitraa Backend — EasyPanel → backend → Environment
DATABASE_URL=mysql+pymysql://sitraa:YOUR_PASSWORD@sitraa_database:3306/sitraa
ALLOWED_ORIGINS=https://sitraa.shop,http://localhost:3000
SECRET_KEY=generate_a_strong_secret_key_here

# Admin — https://api.sitraa.shop/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_TOKEN_HOURS=12

ANALYTICS_STRICT_IP_FILTER=false
DEFAULT_COGS_RATIO=0.55

AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
META_SYNC_DAYS=7
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
USD_TO_DZD=141.18

GOOGLE_SHEET_WEBHOOK_URL=

DHD_API_TOKEN=
DHD_API_URL=https://platform.dhd-dz.com
DHD_SHIP_ON_ORDER=false

ALLOWED_DESKTOP_IPS=
HIGH_PRICE_THRESHOLD=5000
MAX_QTY_HIGH_PRICE=2
MAX_QTY_LOW_PRICE=4
ORDERS_PER_IP_PER_DAY=1
ORDERS_PER_PHONE_PER_DAY=1
